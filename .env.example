# BreachWright configuration
# Copy the settings you need to the platform-specific .env described in README.md.

# Provider: anthropic, openai, azure, bedrock, or local
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
# Optional advanced override. Leave blank for the Breachwright recommendation.
ANTHROPIC_MODEL=

# OpenAI
OPENAI_API_KEY=
# Optional advanced override. Leave blank for the Breachwright recommendation.
OPENAI_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=v1

# AWS Bedrock. Standard AWS credential discovery is used.
AWS_REGION=us-east-1
# Required because available model and inference profile IDs vary by region.
BEDROCK_MODEL_ID=

# Local or self-hosted OpenAI-compatible model
LOCAL_MODEL_URL=http://localhost:11434
# Required. Select an installed model in Settings after connecting to the server.
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_TIMEOUT=120

# Optional application settings
HOST=127.0.0.1
PORT=13370
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Docker Compose only
POSTGRES_DB=breachwright
POSTGRES_USER=breachwright
POSTGRES_PASSWORD=replace-with-a-strong-random-password
