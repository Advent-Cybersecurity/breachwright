# BreachWright configuration
# The canonical runtime .env is stored in the platform data directory.

# Provider: anthropic, openai, azure, bedrock, or local
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Local or self-hosted OpenAI-compatible model
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.1
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_TIMEOUT=120

# Optional application settings
HOST=127.0.0.1
PORT=13370
CORS_ORIGINS=http://localhost,http://127.0.0.1
